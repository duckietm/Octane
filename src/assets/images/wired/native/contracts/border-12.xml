<?xml version="1.0"?>
<skin name="border_12" version="0.0">

	<!-- shared variables -->

	<variables>
		<variable key="asset"	value="habbo_blue_skin_png"	type="String" />
	</variables>

	<!-- the following maps layouts for render states -->

	<states>
		<state name="default"  layout="border_12" template="border_12" />
		<state name="active"   layout="border_12" template="border_12" />
		<!--
		<state name="pressed"  layout="border_outline" template="default_border" />
		<state name="selected" layout="border_outline" template="default_border" />
		-->
	</states>

	<!-- templates defines regions in bitmap asset -->

	<templates>

		<template name="border_12" asset="$asset">
			<entities>
                <entity name="top_left"	  type="bitmap"><region><Rectangle x="19"  y="51" width="5" height="5" /></region></entity>
                <entity name="top_center" type="bitmap"><region><Rectangle x="24"  y="51" width="1" height="5" /></region></entity>
                <entity name="top_right"  type="bitmap"><region><Rectangle x="25"  y="51" width="5" height="5" /></region></entity>

                <entity name="mid_left"	  type="bitmap"><region><Rectangle x="19"  y="56" width="5" height="1" /></region></entity>
                <entity name="mid_center" type="bitmap"><region><Rectangle x="24"  y="56" width="1" height="1" /></region></entity>
                <entity name="mid_right"  type="bitmap"><region><Rectangle x="25"  y="56" width="5" height="1" /></region></entity>

                <entity name="btm_left"	  type="bitmap"><region><Rectangle x="19"  y="57" width="5" height="5" /></region></entity>
                <entity name="btm_center" type="bitmap"><region><Rectangle x="24"  y="57" width="1" height="5" /></region></entity>
                <entity name="btm_right"  type="bitmap"><region><Rectangle x="25"  y="57" width="5" height="5" /></region></entity>
			</entities>
		</template>

	</templates>

	<!-- markup for layout drawer -->

	<layouts>
		<layout name="border_12" transparent="true">
			<entities>

				<!-- top left -->

				<entity name="top_left" id="0">
					<region><Rectangle x="0" y="0" width="5" height="5" /></region>
					<scale horizontal="fixed" vertical="fixed" />
				</entity>

				<!-- top center -->

				<entity name="top_center" id="0">
					<region><Rectangle x="5"  y="0" width="20" height="5" /></region>
					<scale horizontal="strech" vertical="fixed" />
				</entity>

				<!-- top right -->

				<entity name="top_right" id="0">
					<region><Rectangle x="25" y="0" width="5" height="5" /></region>
					<scale horizontal="move" vertical="fixed" />
				</entity>

				<!-- mid left -->

				<entity name="mid_left" id="0">
					<region><Rectangle x="0" y="5" width="5" height="10" /></region>
					<scale horizontal="fixed" vertical="strech" />
				</entity>

				<!-- mid center -->

				<entity name="mid_center" id="0">
					<region><Rectangle x="5" y="5" width="20" height="10" /></region>
					<scale horizontal="strech" vertical="strech" />
				</entity>

				<!-- mid right -->

				<entity name="mid_right" id="0">
					<region><Rectangle x="25" y="5" width="5" height="10" /></region>
					<scale horizontal="move" vertical="strech" />
				</entity>

				<!-- btm left -->

				<entity name="btm_left" id="0">
					<region><Rectangle x="0" y="15" width="5" height="5" /></region>
					<scale horizontal="fixed" vertical="move" />
				</entity>

				<!-- btm center -->

				<entity name="btm_center" id="0">
					<region><Rectangle x="5"  y="15" width="20" height="5" /></region>
					<scale horizontal="strech" vertical="move" />
				</entity>

				<!-- btm right -->

				<entity name="btm_right" id="0">
					<region><Rectangle x="25" y="15" width="5" height="5" /></region>
					<scale horizontal="move" vertical="move" />
				</entity>

			</entities>

		</layout>
	</layouts>
</skin>
