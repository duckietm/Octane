                <entity name="top_right" type="bitmap"><region><Rectangle x="151" y= "184" width="6" height="6" /></region></entity>
                <entity name="mid_right" type="bitmap"><region><Rectangle x="151" y= "190" width="6" height="11" /></region></entity>
