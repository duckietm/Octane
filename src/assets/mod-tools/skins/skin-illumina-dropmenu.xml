<?xml version="1.0"?>
<skin name="illumina_light_skin_dropmenu" version="0.0">

    <!-- shared variables -->

    <variables>
        <variable key="asset"	value="habbo_skin_illumina_light_png"	type="String"	/>
    </variables>

    <!-- the following maps layouts for render states -->

    <states>

        <state name="default" layout="illumina_light_dropmenu_frame" template="dropmenu_frame_default" />
        <state name="hovering"  layout="illumina_light_dropmenu_frame" template="dropmenu_frame_hovering" />
        <!-- <state name="pressed" layout="dropmenu_frame" template="dropmenu_frame_default" /> -->

        <state name="default" layout="illumina_light_dropmenu_button" template="dropmenu_button_default" />
        <state name="hovering"  layout="illumina_light_dropmenu_button" template="dropmenu_button_hover" />
        <state name="pressed" layout="illumina_light_dropmenu_button" template="dropmenu_button_pressed" />

        <state name="default"  layout="illumina_light_dropmenu_item" template="dropmenu_item_default" />
        <state name="pressed"  layout="illumina_light_dropmenu_item" template="dropmenu_item_select" />
        <state name="hovering" layout="illumina_light_dropmenu_item" template="dropmenu_item_hover"  />
        <state name="selected" layout="illumina_light_dropmenu_item" template="dropmenu_item_select"  />

    </states>

