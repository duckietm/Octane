        <template name="dropmenu_frame_default" asset="$asset">
            <entities>
                <entity name="top_left" type="bitmap"><region><Rectangle x="5" y= "184" width="6" height="6" /></region></entity>
                <entity name="mid_left" type="bitmap"><region><Rectangle x="5" y= "190" width="6" height="10" /></region></entity>
                <entity name="btm_left" type="bitmap"><region><Rectangle x="5" y= "200" width="6" height="6" /></region></entity>
                <entity name="top_center" type="bitmap"><region><Rectangle x="11" y= "184" width="4" height="6" /></region></entity>
                <entity name="mid_center" type="bitmap"><region><Rectangle x="11" y= "190" width="4" height="11" /></region></entity>
                <entity name="btm_center" type="bitmap"><region><Rectangle x="11" y= "200" width="4" height="6" /></region></entity>
