    "battleball.arena.1": "Sky Peak",
    "battleball.arena.2": "Coral Beach",
    "battleball.arena.3": "Maze Park",
    "battleball.arena.4": "Gothic Hallway",
    "battleball.arena.5": "Barebones Classic",
    "battleball.team.0": "Team Rot",
    "battleball.team.1": "Team Blau",
    "battleball.team.2": "Team Gelb",
    "battleball.team.3": "Team Grün",
    "battleball.power.1": "Glühbirne",
    "battleball.power.2": "Sprungfeder",
    "battleball.power.3": "Taschenlampe",
    "battleball.power.4": "Kanone",
    "battleball.power.5": "Reißzwecken",
    "battleball.power.6": "Harlekin",
    "battleball.power.7": "Bombe",
    "battleball.power.8": "Staubsauger",
    "battleball.power.9": "Fragezeichen",
    "battleball.power.1.text": "Die Glühbirne färbt einen Bereich um dich herum.",
    "battleball.power.2.text": "Mit der Sprungfeder sperrst du Felder mit einem einzigen Sprung (10 Sekunden).",
    "battleball.power.3.text": "Die Taschenlampe färbt eine gerade Linie vor dir.",
    "battleball.power.4.text": "Ein Kanonenschuss sperrt die Felder einer geraden Linie und wirft alle um, die im Weg stehen.",
    "battleball.power.5.text": "Wer auf eine Reißzwecke springt, dem platzt der Ball: Verteile sie vor deinen Gegnern.",
    "battleball.power.6.text": "Mit dem Harlekin färben alle für dein Team (10 Sekunden).",
    "battleball.power.7.text": "Die Bombe löscht die Felder um dich herum und betäubt alle in der Nähe, auch dich.",
    "battleball.power.8.text": "Mit dem Staubsauger wird jedes Feld, auf das du springst, wieder grau (10 Sekunden).",
    "battleball.power.9.text": "Eine Überraschung: eines der anderen Power-ups.",
    "battleball.rules.create_title": "Spiel erstellen",
    "battleball.rules.help_title": "BattleBall: die Regeln",
    "battleball.rules.title": "Spielregeln",
    "battleball.rules.tab.game": "Das Spiel",
    "battleball.rules.tab.how": "So wird gespielt",
    "battleball.rules.tab.powers": "Die Power-ups",
    "battleball.rules.arena": "Wähle die Arena:",
    "battleball.rules.teams": "Teams",
    "battleball.rules.per_team": "Spieler pro Team",
    "battleball.rules.minutes": "Dauer",
    "battleball.rules.minutes_n": "%n% Min.",
    "battleball.rules.classic": "Keine Power-ups in Barebones Classic: Die Felder brauchen vier Sprünge.",
    "battleball.rules.powers": "Power-ups im Spiel:",
    "battleball.rules.bots": "Roboter",
    "battleball.rules.bots.hint": "Der Gastgeber kann die Teams mit Robotern auffüllen.",
    "battleball.rules.open": "Spiel erstellen",
    "battleball.rules.save": "Speichern",
    "battleball.how.goal.title": "Das Ziel",
    "battleball.how.goal.text": "Zwei bis vier Teams springen auf ihren Bällen durch die Arena. Jedes Feld, auf das du springst, nimmt die Farbe deines Teams an. Wenn die Zeit um ist, gewinnt das Team, dessen Felder die meisten Punkte wert sind.",
    "battleball.how.tiles.title": "Die Felder",
    "battleball.how.tiles.text": "Ein graues Feld braucht drei Sprünge deines Teams, bis es gesperrt ist (vier in Barebones Classic): Es wird jedes Mal heller. Ein Feld in einer anderen Farbe, das noch nicht gesperrt ist, kannst du klauen, indem du darauf springst. Ein gesperrtes Feld gehört dir bis zum Ende (nur die Bombe und der Staubsauger können es löschen).",
    "battleball.how.fill.title": "Bereiche einschließen",
    "battleball.how.fill.text": "Sperre einen Ring aus Feldern um einen Bereich, gern auch am Rand entlang: Der ganze Bereich darin wird auf einen Schlag für dein Team gesperrt!",
    "battleball.how.points.title": "Die Punkte",
    "battleball.how.points.text": "Jede Stufe eines Feldes bringt Punkte: 2, dann 6, dann 10, dann 14, sobald es gesperrt ist, und 2 extra für ein geklautes Feld. Ein geklautes Feld zieht dem Team, dem es gehörte, seine Punkte ab.",
    "battleball.how.moving.title": "Springen",
    "battleball.how.moving.text": "Klick auf ein Feld: Dein Ball springt dorthin, ein Feld nach dem anderen. Durch andere Spieler hindurch kommst du nicht.",
    "battleball.how.powers.title": "Die Power-ups",
    "battleball.how.powers.text": "Ab und zu erscheinen Power-ups auf dem Boden: Spring darauf, um eines aufzusammeln, und setz es dann mit dem Knopf in der unteren Leiste oder mit der Leertaste ein. Du kannst immer nur eines haben, für 15 Sekunden.",
    "battleball.robot": "Roboter",
