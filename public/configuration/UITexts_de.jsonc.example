    "battleball.title": "BattleBall",
    "battleball.lobby.title": "BattleBall",
    "battleball.intro": "Spring auf deinem Ball, färbe die Felder in den Farben deines Teams und sperre sie vor den anderen! Power-ups helfen dir dabei.",
    "battleball.no_games": "Noch keine Spiele: Erstelle eins und lade deine Freunde oder Roboter ein.",
    "battleball.game_of": "Spiel von %name%",
    "battleball.teams_count": "%teams% Teams · %players%/%max% Spieler",
    "battleball.join": "Beitreten",
