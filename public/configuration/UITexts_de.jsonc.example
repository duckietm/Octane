    "werewolf.role.little_girl": "Kleines Mädchen",
    "werewolf.role.elder": "Dorfältester",
    "werewolf.role.idiot": "Dorfdepp",
    "werewolf.role.scapegoat": "Sündenbock",
    "werewolf.role.raven": "Rabe",
    "werewolf.role.fox": "Fuchs",
    "werewolf.role.bear_tamer": "Bärenführer",
    "werewolf.role.knight": "Ritter mit dem rostigen Schwert",
    "werewolf.role.sister": "Schwester",
    "werewolf.role.sister.plural": "Schwestern",
    "werewolf.role.wild_child": "Wildes Kind",
    "werewolf.role.wolf_dog": "Wolfshund",
    "werewolf.role.big_bad_wolf": "Großer böser Wolf",
    "werewolf.role.accursed_father": "Urwolf",
    "werewolf.role.white_wolf": "Weißer Werwolf",
    "werewolf.role.piper": "Flötenspieler",
    "werewolf.role.angel": "Engel",
    "werewolf.camp.village": "Das Dorf",
    "werewolf.camp.wolves": "Die Werwölfe",
    "werewolf.camp.alone": "Einzelgänger",
    "werewolf.in_pack": "Im Rudel",
    "werewolf.charmed": "Verzaubert",
    "werewolf.a_werewolf": "Ein Werwolf",
    "werewolf.someone": "Jemand",
    "werewolf.power.little_girl": "Nachts spionierst du die Werwölfe aus: Du liest ihre Nachrichten und siehst ihr Opfer, aber nicht, wer sie sind.",
    "werewolf.power.elder": "Du überlebst den ersten Angriff der Werwölfe. Wenn das Dorf dich tötet, verliert es seine Fähigkeiten.",
    "werewolf.power.idiot": "Stimmt das Dorf gegen dich, erkennt es dich und verschont dich: Du bleibst, darfst aber nicht mehr abstimmen.",
    "werewolf.power.scapegoat": "Endet die Abstimmung mit Gleichstand, fliegst du raus.",
    "werewolf.power.raven": "Wähle jede Nacht einen Spieler: Morgen startet er mit zwei Stimmen gegen sich in die Abstimmung.",
    "werewolf.power.fox": "Beschnüffle jede Nacht einen Spieler und seine beiden Nachbarn: Du erfährst, ob ein Werwolf unter ihnen ist. Liegst du einmal falsch, verlierst du deine Spürnase.",
    "werewolf.power.bear_tamer": "Jeden Morgen brummt dein Bär, wenn ein Werwolf neben dir sitzt.",
    "werewolf.power.knight": "Wenn die Werwölfe dich fressen, tötet dein rostiges Schwert in der nächsten Nacht den ersten Werwolf zu deiner Linken.",
    "werewolf.power.sister": "Du und deine Schwester kennt euch: Ihr könnt einander vertrauen.",
    "werewolf.power.wild_child": "Wähle in der ersten Nacht ein Vorbild. Stirbt dein Vorbild, wirst du zum Werwolf.",
    "werewolf.power.wolf_dog": "Wähle in der ersten Nacht deine Seite: Dorfbewohner bleiben oder dich den Werwölfen anschließen.",
    "werewolf.power.big_bad_wolf": "Du jagst mit dem Rudel und danach allein: ein Opfer mehr pro Nacht, solange kein Werwolf gestorben ist.",
    "werewolf.power.accursed_father": "Einmal im Spiel kannst du das Opfer des Rudels infizieren, statt es zu fressen: Es wird zum Werwolf.",
    "werewolf.power.white_wolf": "Du jagst mit dem Rudel, spielst aber für dich allein: Jede zweite Nacht darfst du einen Werwolf fressen. Gewinne allein.",
    "werewolf.power.piper": "Verzaubere jede Nacht zwei Spieler. Du gewinnst allein, wenn alle anderen Lebenden verzaubert sind.",
    "werewolf.power.angel": "Lass dich am ersten Tag (oder in der ersten Nacht) rauswerfen, dann gewinnst du allein. Sonst spielst du mit dem Dorf.",
    "werewolf.desc.werewolf": "Jede Nacht erwacht das Rudel, wählt gemeinsam ein Opfer und frisst es. Tagsüber sitzen die Werwölfe unter den Dorfbewohnern und tun so, als gehörten sie dazu. Sie gewinnen, wenn nur noch Werwölfe übrig sind.",
    "werewolf.desc.villager": "Der Dorfbewohner hat keine andere Fähigkeit als seine Stimme. Hör zu, stell Fragen, erkenne die Lügen: Das Dorf gewinnt, wenn alle Werwölfe verschwunden sind.",
    "werewolf.desc.seer": "Jede Nacht blickt die Seherin in ihre Kristallkugel und erfährt die Rolle eines Spielers ihrer Wahl. Nutze dein Wissen, ohne dich zu verraten: Die Werwölfe würden dich zu gern fressen.",
    "werewolf.desc.witch": "Die Hexe erwacht nach den Werwölfen und erfährt, wen sie angegriffen haben. Sie hat einen Heiltrank, um diesen Spieler zu retten, und einen Gifttrank, um zu töten, wen sie will. Jeder Trank wirkt nur einmal im Spiel.",
    "werewolf.desc.hunter": "Wenn der Jäger stirbt, egal wodurch, gibt er einen letzten Schuss ab: Er wählt einen Spieler, der mit ihm stirbt. Ziel gut!",
    "werewolf.desc.cupid": "In der ersten Nacht wählt Amor zwei Verliebte (auf Wunsch auch sich selbst). Sie erfahren gegenseitig ihre Rollen. Stirbt einer, stirbt der andere an gebrochenem Herzen. Ein verliebter Dorfbewohner und ein verliebter Werwolf gewinnen gemeinsam, wenn sie die letzten beiden sind.",
    "werewolf.desc.guard": "Jede Nacht beschützt der Heiler einen Spieler (auch sich selbst) vor dem Angriff der Werwölfe. Er darf nicht zwei Nächte hintereinander denselben Spieler beschützen. Gegen das Gift der Hexe hilft sein Schutz nicht.",
    "werewolf.desc.little_girl": "Während die Werwölfe ihr Opfer wählen, blinzelt das kleine Mädchen: Es liest, was das Rudel sagt und wen es wählt, sieht aber nicht, wer spricht.",
    "werewolf.desc.elder": "Der Dorfälteste ist zäh: Die Werwölfe müssen ihn zweimal angreifen, um ihn zu töten. Tötet ihn aber das Dorf (durch Abstimmung, Hexe oder Jäger), verliert das Dorf vor Scham seine besonderen Fähigkeiten.",
    "werewolf.desc.idiot": "Stimmt das Dorf gegen den Dorfdepp, erfahren alle seine Rolle und verschonen ihn: Er bleibt im Dorf, darf aber nicht mehr abstimmen.",
    "werewolf.desc.scapegoat": "Endet die Abstimmung mit Gleichstand, fliegt niemand anderes raus: Der Sündenbock zahlt für alle.",
    "werewolf.desc.raven": "Jede Nacht darf der Rabe einen Spieler wählen. Am nächsten Tag startet dieser Spieler mit zwei Stimmen gegen sich in die Abstimmung, und alle wissen es.",
    "werewolf.desc.fox": "Jede Nacht beschnüffelt der Fuchs einen Spieler und dessen beide lebenden Nachbarn. Ist unter den dreien ein Werwolf, riecht er ihn. Sonst verliert er seine Spürnase und seine Fähigkeit für den Rest des Spiels.",
    "werewolf.desc.bear_tamer": "Jeden Morgen brummt der Bär des Bärenführers (alle hören es), wenn mindestens einer der beiden lebenden Nachbarn seines Herrn ein Werwolf ist.",
    "werewolf.desc.knight": "Fressen die Werwölfe den Ritter, verletzt sein rostiges Schwert einen von ihnen: Der erste Werwolf zu seiner Linken stirbt in der nächsten Nacht an Wundstarrkrampf.",
    "werewolf.desc.sister": "Die beiden Schwestern kennen sich ab der ersten Nacht. Zwei Spieler, die einander vertrauen können: eine wertvolle Hilfe für das Dorf.",
    "werewolf.desc.wild_child": "In der ersten Nacht wählt das wilde Kind ein Vorbild. Solange sein Vorbild lebt, spielt es für das Dorf. Stirbt sein Vorbild, wird es zum Werwolf und schließt sich dem Rudel an.",
    "werewolf.desc.wolf_dog": "In der ersten Nacht entscheidet der Wolfshund: ein treuer Dorfbewohner bleiben oder sich den Werwölfen anschließen und für den Rest des Spiels mit ihnen jagen.",
    "werewolf.desc.big_bad_wolf": "Der große böse Wolf jagt mit dem Rudel, erwacht dann allein und frisst ein zweites Opfer, solange kein Mitglied des Rudels gestorben ist.",
    "werewolf.desc.accursed_father": "Einmal im Spiel, wenn das Rudel sein Opfer gewählt hat, kann der Urwolf es infizieren, statt es zu fressen: Das Opfer überlebt, wird aber zum Werwolf und behält seine Fähigkeit.",
    "werewolf.desc.white_wolf": "Der weiße Werwolf jagt mit dem Rudel, spielt aber nur für sich: Jede zweite Nacht darf er einen Werwolf fressen. Er gewinnt, wenn er als Letzter überlebt.",
    "werewolf.desc.piper": "Jede Nacht verzaubert der Flötenspieler zwei Spieler. Die Verzauberten erfahren, wer sonst noch verzaubert ist. Er gewinnt allein, sobald alle anderen lebenden Spieler verzaubert sind.",
    "werewolf.desc.angel": "Der Engel will sofort in den Himmel: Fliegt er am ersten Tag raus (oder wird in der ersten Nacht gefressen), gewinnt er allein und das Spiel endet. Sonst wird er ein einfacher Dorfbewohner.",
    "werewolf.step.wolf_dog": "Der Wolfshund",
    "werewolf.step.wild_child": "Das wilde Kind",
    "werewolf.step.fox": "Der Fuchs",
    "werewolf.step.raven": "Der Rabe",
    "werewolf.step.accursed": "Der Urwolf",
    "werewolf.step.big_bad_wolf": "Der große böse Wolf",
    "werewolf.step.white_wolf": "Der weiße Werwolf",
    "werewolf.step.piper": "Der Flötenspieler",
    "werewolf.log.step.wolf_dog": "Der Wolfshund erwacht und wählt seine Seite...",
    "werewolf.log.step.wild_child": "Das wilde Kind erwacht und wählt sein Vorbild...",
    "werewolf.log.step.fox": "Der Fuchs erwacht und schnüffelt im Dorf herum...",
    "werewolf.log.step.raven": "Der Rabe erwacht und sucht eine Schulter zum Landen...",
    "werewolf.log.step.accursed": "Der Urwolf überlegt, ob er zubeißen soll...",
    "werewolf.log.step.big_bad_wolf": "Der große böse Wolf erwacht, immer noch hungrig...",
    "werewolf.log.step.white_wolf": "Der weiße Werwolf erwacht, ganz allein...",
    "werewolf.log.step.piper": "Der Flötenspieler erwacht und spielt seine Melodie...",
    "werewolf.log.sister": "Deine Schwester ist %name%. Ihr könnt einander vertrauen.",
    "werewolf.log.fox_yes": "Deine Nase zuckt: Neben %name% ist ein Werwolf (oder %name% ist einer).",
    "werewolf.log.fox_no": "Kein Werwolf in der Nähe von %name%... du hast deine Spürnase verloren.",
    "werewolf.log.raven": "Ein Rabe hat sich auf die Schulter von %name% gesetzt: zwei Stimmen gegen diese Person.",
    "werewolf.log.pack_joins.infected": "Der Biss hat bei %name% gewirkt: Das Rudel hat ein Mitglied mehr!",
    "werewolf.log.pack_joins.wild_child": "%name%, das wilde Kind, schließt sich dem Rudel an!",
    "werewolf.log.pack_joins.wolf_dog": "%name%, der Wolfshund, schließt sich dem Rudel an!",
    "werewolf.log.infected": "Der Urwolf hat dich gebissen: Du gehörst jetzt zum Rudel! Behalte deine Fähigkeit und jage mit ihm.",
    "werewolf.log.wolf_dog_wolf": "Du schließt dich den Werwölfen an: Ab heute Nacht jagst du mit dem Rudel.",
    "werewolf.log.wolf_dog_village": "Du bleibst ein treuer Dorfbewohner.",
    "werewolf.log.wild_child_model": "Dein Vorbild ist %name%. Stirbt diese Person, wirst du zum Werwolf.",
    "werewolf.log.wild_child_turns": "Dein Vorbild %name% ist nicht mehr: Du wirst zum Werwolf!",
    "werewolf.log.elder_survives": "Die Werwölfe wollten dich fressen, aber du hast durchgehalten. Beim nächsten Mal hast du dieses Glück nicht.",
    "werewolf.log.elder_curse": "Das Dorf hat seinen Dorfältesten %name% getötet: Vor Scham verlieren die besonderen Rollen des Dorfes ihre Fähigkeiten.",
    "werewolf.log.idiot_spared": "%name% ist der Dorfdepp: Das Dorf verschont diese Person, aber sie darf nicht mehr abstimmen.",
    "werewolf.log.scapegoat": "Gleichstand! Der Sündenbock %name% zahlt für alle.",
    "werewolf.log.vote_none": "Niemand hat abgestimmt: Niemand fliegt raus.",
    "werewolf.log.bear_growls": "Grrr! Der Bär von %name% brummt: Ein Werwolf sitzt nebenan!",
    "werewolf.log.bear_quiet": "Der Bär von %name% bleibt ruhig.",
    "werewolf.log.charmed": "Die Melodie des Flötenspielers: Verzaubert sind %names%.",
    "werewolf.log.win.white_wolf": "Der weiße Werwolf gewinnt, allein auf den Ruinen des Dorfes!",
    "werewolf.log.win.piper": "Der Flötenspieler gewinnt: Das ganze Dorf tanzt zu seiner Melodie!",
    "werewolf.log.win.angel": "Der Engel gewinnt: Er ist direkt in den Himmel aufgestiegen!",
    "werewolf.cause.white_wolf": "hat den weißen Werwolf nicht überlebt",
    "werewolf.cause.rust": "stirbt an Wundstarrkrampf, wegen des rostigen Schwerts des Ritters",
    "werewolf.cause.scapegoat": "zahlt für den Gleichstand",
    "werewolf.instruction.wild_child": "Wähle dein Vorbild. Stirbt diese Person, wirst du zum Werwolf.",
    "werewolf.button.wild_child": "Wählen",
    "werewolf.instruction.fox": "Wähle einen Spieler zum Beschnüffeln: Du erfährst, ob unter ihm und seinen beiden Nachbarn ein Werwolf ist.",
    "werewolf.button.fox": "Beschnüffeln",
    "werewolf.instruction.raven": "Wähle einen Spieler: Morgen startet er mit zwei Stimmen gegen sich in die Abstimmung.",
    "werewolf.button.raven": "Markieren",
    "werewolf.pass.raven": "Niemand",
    "werewolf.instruction.big_bad_wolf": "Jetzt bist du allein: Wähle ein zweites Opfer zum Fressen.",
    "werewolf.button.big_bad_wolf": "Fressen",
    "werewolf.instruction.white_wolf": "Du kannst heute Nacht einen Werwolf aus dem Rudel fressen oder ihn verschonen.",
    "werewolf.button.white_wolf": "Fressen",
    "werewolf.pass.white_wolf": "Rudel verschonen",
    "werewolf.instruction.piper": "Wähle zwei Spieler zum Verzaubern.",
    "werewolf.button.piper": "Verzaubern",
    "werewolf.wolf_dog.what": "Wähle deine Seite, für das ganze Spiel.",
    "werewolf.wolf_dog.village": "Dorfbewohner bleiben",
    "werewolf.wolf_dog.wolf": "Zu den Werwölfen",
    "werewolf.accursed.what": "Das Rudel hat %name% gewählt. Infizieren statt fressen (nur einmal im Spiel)?",
    "werewolf.accursed.infect": "%name% infizieren",
    "werewolf.accursed.devour": "Fressen lassen",
    "werewolf.hunter_aims": "Der Jäger %name% legt sein Gewehr an...",
    "werewolf.peeking": "Du spähst zwischen deinen Fingern zu den Werwölfen... lies ihre Nachrichten im Chat.",
    "werewolf.no_vote": "Du darfst nicht mehr abstimmen: Schau den anderen zu.",
    "werewolf.reveal.your_role": "Deine Rolle",
    "werewolf.reveal.secret": "Halte sie geheim!",
    "werewolf.reveal.you_died": "Für dich ist es vorbei!",
    "werewolf.reveal.died": "%name% verlässt uns",
    "werewolf.reveal.hidden": "Die Rolle bleibt geheim.",
    "werewolf.reveal.pack": "Du gehörst jetzt zum Rudel!",
    "werewolf.reveal.ok": "Verstanden!",
    "werewolf.reveal.next": "OK",
    "werewolf.rules.tab.game": "Das Spiel",
    "werewolf.rules.tab.how": "So wird gespielt",
    "werewolf.rules.tab.roles": "Die Rollen",
    "werewolf.rules.help_title": "Werwolf: die Regeln",
    "werewolf.rules.help": "Spielregeln",
    "werewolf.rules.wolves_count": "Werwölfe",
    "werewolf.rules.auto": "Auto (%n%)",
    "werewolf.rules.roles": "Rollen im Dorf",
    "werewolf.rules.classic": "Klassisch",
    "werewolf.rules.all": "Alle",
    "werewolf.rules.none": "Keine",
    "werewolf.rules.draw": "%n% Plätze für %count% gewählte Rollen: Die Rollen jedes Spiels werden unter ihnen ausgelost. Die besonderen Wölfe ersetzen Werwölfe.",
    "werewolf.rules.fill": "Die übrigen Plätze sind Dorfbewohner. Die besonderen Wölfe ersetzen Werwölfe.",
    "werewolf.rules.roles_hint": "Klick auf eine Rolle, um ihre Karte und alles, was sie kann, zu sehen.",
    "werewolf.how.goal.title": "Das Ziel",
    "werewolf.how.goal.text": "Unter den Dorfbewohnern verstecken sich Werwölfe. Das Dorf muss sie entlarven und per Abstimmung rauswerfen; die Werwölfe müssen das Dorf fressen, ohne erwischt zu werden. Manche Rollen spielen allein und gewinnen auf ihre eigene Art.",
    "werewolf.how.start.title": "Der Anfang",
    "werewolf.how.start.text": "Zu Beginn bekommt jeder heimlich eine Rolle: Deine Karte zeigt sie dir, mit ihrer Fähigkeit. Zeig sie niemals: Lüg, wenn es sein muss!",
    "werewolf.how.night.title": "Die Nacht",
    "werewolf.how.night.text": "Nachts schläft das Dorf und niemand darf sprechen, aber die Werwölfe flüstern miteinander. Die Rollen erwachen eine nach der anderen: Amor und die Rollen der ersten Nacht, der Heiler, die Seherin, der Fuchs, der Rabe, dann wählen die Werwölfe ein Opfer, dann die Hexe, der Flötenspieler... Wenn du dran bist, sagt dir dein Fenster, was zu tun ist: Klick auf den Namen eines Spielers über seinem Kopf, um ihn zu wählen.",
    "werewolf.how.day.title": "Der Tag",
    "werewolf.how.day.text": "Im Morgengrauen verkündet der Erzähler, wer in der Nacht gestorben ist, und seine Karte wird allen gezeigt. Dann diskutiert das Dorf im Chat: Wer lügt? Wer ist zu still? Wenn du fertig bist, klick auf „Zur Abstimmung“.",
    "werewolf.how.vote.title": "Die Abstimmung",
    "werewolf.how.vote.text": "Jeder Spieler stimmt gegen den, den er verdächtigt, indem er auf dessen Namen klickt. Wer die meisten Stimmen hat, fliegt raus und seine Karte wird aufgedeckt. Bei Gleichstand fliegt niemand raus (außer es gibt einen Sündenbock).",
    "werewolf.how.death.title": "Die Toten",
    "werewolf.how.death.text": "Ein toter Spieler spricht nicht mehr mit den Lebenden: Er schaut dem Spiel zu und unterhält sich mit den anderen Toten. Der Jäger dagegen gibt im Sterben einen letzten Schuss ab.",
    "werewolf.how.win.title": "Wer gewinnt?",
    "werewolf.how.win.text": "Das Dorf gewinnt, wenn kein Werwolf mehr übrig ist. Die Werwölfe gewinnen, wenn nur noch Werwölfe übrig sind. Zwei Verliebte aus verschiedenen Lagern gewinnen, wenn sie die letzten beiden sind. Der weiße Werwolf, der Flötenspieler und der Engel gewinnen allein, jeder auf seine Art.",
    "werewolf.how.tips.title": "Tipps",
    "werewolf.how.tips.text": "Rede, aber nicht zu viel. Achte auf die Stimmen: Die Werwölfe stimmen oft gemeinsam ab. Eine Seherin, die sich zu früh verrät, lebt nicht lange!",
    "werewolf.error.nothing_to_do": "Gerade gibt es nichts zu tun.",
    "wobble.lobby.title": "Wobble Squabble",
    "wobble.intro": "Zwei Spieler, ein Balken, ein Pool. Halte dein Gleichgewicht und schick deinen Gegner baden!",
    "wobble.no_games": "Noch keine Duelle: Eröffne eins und fordere einen Spieler oder Roboter heraus.",
    "wobble.duel_of": "%name% wartet auf einen Gegner",
    "wobble.join": "Herausfordern",
    "wobble.state.playing": "Voll",
    "wobble.create": "Duell eröffnen",
    "wobble.rules.help": "Spielregeln",
