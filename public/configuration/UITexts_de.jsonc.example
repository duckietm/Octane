    "wobble.rules.rounds": "Runden zum Sieg",
    "wobble.rules.bots": "Roboter",
    "wobble.rules.bots.hint": "Ohne Gegner kann der Gastgeber einen Roboter auf den Balken rufen.",
    "wobble.rules.level": "Stärke des Roboters",
