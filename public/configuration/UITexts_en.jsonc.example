    "werewolf.log.pack_joins.wild_child": "%name%, the Wild Child, joins the pack!",
    "werewolf.log.pack_joins.wolf_dog": "%name%, the Wolfhound, joins the pack!",
    "werewolf.log.infected": "The Accursed Wolf-Father sank his fangs into you: you are now part of the pack! Keep your power, and hunt with them.",
    "werewolf.log.wolf_dog_wolf": "You join the werewolves: you hunt with the pack from tonight.",
    "werewolf.log.wolf_dog_village": "You stay a faithful villager.",
    "werewolf.log.wild_child_model": "Your model is %name%. If they die, you become a werewolf.",
    "werewolf.log.wild_child_turns": "Your model %name% is dead: you become a werewolf!",
    "werewolf.log.elder_survives": "The werewolves tried to devour you, but you held on. Next time, you won't be so lucky.",
    "werewolf.log.elder_curse": "The village killed its Elder, %name%: in shame, the special roles of the village lose their powers.",
    "werewolf.log.idiot_spared": "%name% is the Village Idiot: the village spares them, but they will vote no more.",
    "werewolf.log.scapegoat": "Tie! The Scapegoat, %name%, pays for everybody.",
    "werewolf.log.vote_none": "Nobody voted: nobody is eliminated.",
    "werewolf.log.bear_growls": "Grrr! %name%'s bear growls: a werewolf is sitting next to them!",
    "werewolf.log.bear_quiet": "%name%'s bear stays calm.",
    "werewolf.log.charmed": "The Pied Piper's tune: the charmed players are %names%.",
    "werewolf.log.win.white_wolf": "The White Werewolf wins, alone on the ruins of the village!",
    "werewolf.log.win.piper": "The Pied Piper wins: the whole village dances to his tune!",
    "werewolf.log.win.angel": "The Angel wins: straight up to heaven!",
