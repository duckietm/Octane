    "battleball.rules.powers": "Power-ups in the game:",
    "battleball.rules.bots": "Robots",
    "battleball.rules.bots.hint": "The host can fill the teams with robots.",
    "battleball.rules.open": "Create the game",
    "battleball.rules.save": "Save",
    "battleball.how.goal.title": "The goal",
    "battleball.how.goal.text": "Two to four teams bounce on their balls across the arena. Every tile you bounce on takes your team's colour. When time runs out, the team whose tiles are worth the most points wins.",
    "battleball.how.tiles.title": "The tiles",
    "battleball.how.tiles.text": "A grey tile needs three bounces from your team to be locked (four in Barebones Classic): it gets lighter each time. A tile of another colour that isn't locked yet can be stolen by bouncing on it. A locked tile stays yours until the end (only the bomb and the vacuum cleaner can wipe it).",
    "battleball.how.fill.title": "Closing areas",
    "battleball.how.fill.text": "Lock a ring of tiles around an area, against the edges if you like: the whole area inside is locked for your team in one go!",
    "battleball.how.points.title": "Points",
    "battleball.how.points.text": "Each stage of a tile earns points: 2, then 6, then 10, then 14 once locked, and 2 more for a stolen tile. A stolen tile takes its points away from the team it belonged to.",
    "battleball.how.moving.title": "Bouncing",
    "battleball.how.moving.text": "Click a tile: your ball bounces there, one tile at a time. You can't go through other players.",
    "battleball.how.powers.title": "Power-ups",
    "battleball.how.powers.text": "Power-ups appear on the ground now and then: bounce on one to pick it up, then use it with the button on the bottom bar, or the space bar. You can only hold one at a time, for 15 seconds.",
    "battleball.robot": "robot",
