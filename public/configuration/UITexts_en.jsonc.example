    "werewolf.rules.tab.game": "The game",
    "werewolf.rules.tab.how": "How to play",
    "werewolf.rules.tab.roles": "The roles",
    "werewolf.rules.help_title": "Werewolf: the rules",
    "werewolf.rules.help": "Rules of the game",
    "werewolf.rules.wolves_count": "Werewolves",
    "werewolf.rules.auto": "Auto (%n%)",
    "werewolf.rules.roles": "Roles in the village",
    "werewolf.rules.classic": "Classic",
    "werewolf.rules.all": "All",
    "werewolf.rules.none": "None",
    "werewolf.rules.draw": "%n% places for %count% roles chosen: the roles of each game are drawn among them. The special werewolves take the place of werewolves.",
    "werewolf.rules.fill": "The places left are villagers. The special werewolves take the place of werewolves.",
    "werewolf.rules.roles_hint": "Click a role to see its card and everything it can do.",
    "werewolf.how.goal.title": "The goal",
    "werewolf.how.goal.text": "Werewolves are hiding among the villagers. The village must unmask them and vote them out; the werewolves must devour the village without getting caught. Some roles play alone and win in their own way.",
    "werewolf.how.start.title": "The start",
    "werewolf.how.start.text": "At the start of the game, everyone gets a secret role: your card shows it to you, with its power. Never show it: lie if you have to!",
    "werewolf.how.night.title": "The night",
    "werewolf.how.night.text": "At night, the village sleeps and nobody can talk, but the werewolves whisper among themselves. The roles wake up one by one: Cupid and the first-night roles, the Guard, the Seer, the Fox, the Raven, then the werewolves choose a prey, then the Witch, the Pied Piper... When it's your turn, your panel tells you what to do: click a player's name, above their head, to choose them.",
    "werewolf.how.day.title": "The day",
    "werewolf.how.day.text": "At dawn, the narrator announces who died during the night, and their card is shown to everyone. Then the village debates in the chat: who is lying? Who is too quiet? When you are done, click \"Ready to vote\".",
    "werewolf.how.vote.title": "The vote",
    "werewolf.how.vote.text": "Each player votes against the one they suspect, by clicking their name. The player with the most votes is eliminated and their card is turned over. In case of a tie, nobody is eliminated (unless there is a Scapegoat).",
    "werewolf.how.death.title": "The dead",
    "werewolf.how.death.text": "A dead player can no longer talk to the living: they watch the game and chat with the other dead. The Hunter, though, fires one last shot when dying.",
    "werewolf.how.win.title": "Who wins?",
    "werewolf.how.win.text": "The village wins when there are no werewolves left. The werewolves win when only werewolves are left. Two lovers from different sides win if they are the last two left. The White Werewolf, the Pied Piper and the Angel win alone, each in their own way.",
    "werewolf.how.tips.title": "Tips",
    "werewolf.how.tips.text": "Talk, but not too much. Watch the votes: werewolves often vote together. A Seer who reveals herself too early doesn't live long!",
    "werewolf.error.nothing_to_do": "There's nothing to do right now.",
    "wobble.lobby.title": "Wobble Squabble",
    "wobble.intro": "Two fighters, one beam, one pool. Keep your balance and knock your opponent into the water!",
    "wobble.no_games": "No duel yet: open one and challenge a player or a robot.",
