{
    "// ---- Server and connection ----": "",
    "socket.url": "ws://localhost:2096",
    "api.url": "http://localhost:2096",
    "crypto.ws.enabled": false,
    "crypto.ws.signing.enabled": false,
    "crypto.ws.signing.public_key": "",
    "crypto.ws.require_v2": false,
    "system.pong.manually": true,
    "system.pong.interval.ms": 20000,
    "// ---- Base URLs (used by the keys below) ----": "",
    "asset.url": "http://localhost/gamedata",
    "image.library.url": "http://localhost/gamedata/c_images/",
    "images.url": "${asset.url}/images",
    "gamedata.url": "${asset.url}",
    "sounds.url": "${asset.url}/sounds/%sample%.mp3",
    "hof.furni.url": "http://localhost",
    "// ---- Game data and language ----": "",
    "base.locale": "nl",
    "external.texts.url": [
        "${gamedata.url}/config/ExternalTexts.json?t=%timestamp%",
        "${gamedata.url}/config/UITexts.jsonc?t=%timestamp%"
    ],
    "external.texts.translation.url": "",
    "external.samples.url": "${gamedata.url}/sounds/sound_machine_sample_%sample%.mp3",
    "furnidata.url": "${gamedata.url}/config/FurnitureData.json?t=%timestamp%",
    "furnidata.translation.url": "",
    "productdata.url": "${gamedata.url}/config/ProductData.json?t=%timestamp%",
    "// ---- Avatar ----": "",
    "avatar.actions.url": "${gamedata.url}/config/HabboAvatarActions.json?t=%timestamp%",
    "avatar.figuredata.url": "${gamedata.url}/config/FigureData.json?t=%timestamp%",
