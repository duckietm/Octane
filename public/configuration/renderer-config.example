    "avatar.effectmap.url": "${gamedata.url}/config/EffectMap.json?t=%timestamp%",
    "avatar.asset.url": "${asset.url}/clothes/%libname%.hab",
    "avatar.asset.effect.url": "${asset.url}/effect/%libname%.hab",
    "avatareditor.effects.icon.url": "${image.library.url}fx_icons/fx_icon_%type%.png",
    "avatar.mandatory.libraries": [
        "bd:1",
        "li:0"
    ],
    "avatar.mandatory.effect.libraries": [
        "dance.1",
        "dance.2",
        "dance.3",
        "dance.4"
    ],
