    "battleball.rules.per_team": "Spelers per team",
    "battleball.rules.minutes": "Duur",
    "battleball.rules.minutes_n": "%n% min",
    "battleball.rules.classic": "Geen power-ups in Barebones Classic: de tegels hebben vier stuiters nodig.",
    "battleball.rules.powers": "Power-ups in het spel:",
    "battleball.rules.bots": "Robots",
    "battleball.rules.bots.hint": "De host kan de teams aanvullen met robots.",
    "battleball.rules.open": "Spel maken",
    "battleball.rules.save": "Opslaan",
    "battleball.how.goal.title": "Het doel van het spel",
    "battleball.how.goal.text": "Twee tot vier teams stuiteren op hun ballen door de arena. Elke tegel waarop je stuitert, krijgt de kleur van je team. Als de tijd om is, wint het team waarvan de tegels de meeste punten waard zijn.",
    "battleball.how.tiles.title": "De tegels",
    "battleball.how.tiles.text": "Een grijze tegel heeft drie stuiters van je team nodig om vergrendeld te worden (vier in Barebones Classic): hij wordt elke keer lichter. Een tegel van een andere kleur die nog niet vergrendeld is, kun je stelen door erop te stuiteren. Een vergrendelde tegel blijft van jou tot het einde (alleen de bom en de stofzuiger kunnen hem wissen).",
    "battleball.how.fill.title": "Gebieden afsluiten",
    "battleball.how.fill.text": "Vergrendel een ring van tegels rond een gebied, tegen de randen aan als je wilt: het hele gebied binnenin wordt in één keer vergrendeld voor je team!",
    "battleball.how.points.title": "De punten",
    "battleball.how.points.text": "Elke stap van een tegel levert punten op: 2, dan 6, dan 10, dan 14 zodra hij vergrendeld is, en 2 extra voor een gestolen tegel. Een gestolen tegel kost het team waar hij van was zijn punten.",
    "battleball.how.moving.title": "Stuiteren",
    "battleball.how.moving.text": "Klik op een tegel: je bal stuitert ernaartoe, één tegel tegelijk. Je kunt niet door andere spelers heen.",
    "battleball.how.powers.title": "De power-ups",
    "battleball.how.powers.text": "Af en toe verschijnen er power-ups op de grond: stuiter erop om er een op te pakken en gebruik hem met de knop in de onderste balk, of met de spatiebalk. Je houdt er maar één tegelijk, 15 seconden lang.",
    "battleball.robot": "robot",
