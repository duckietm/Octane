    "fastfood.rules.bots_hint": "De host kan de vrije tafels vullen met robots.",
    "fastfood.rules.create": "Spel maken",
    "fastfood.rules.save": "Opslaan",
    "fastfood.rules.close": "Sluiten",
    "fastfood.rules.how.drop.title": "Laat het gerecht vallen",
    "fastfood.rules.how.drop": "Als het gerecht klaar is, druk je op Spatie (of op de grote knop): het valt. Te vroeg is een valse start: het gerecht valt leeg en je wacht langer op het volgende.",
    "fastfood.rules.how.chute.title": "Open de parachute",
    "fastfood.rules.how.chute": "Druk nog een keer om de parachute te openen. Hoe later je hem opent, hoe sneller je gerecht geserveerd is; te laat en het klapt te hard op tafel en het eten is verpest. De klanten laten zien wanneer het spannend wordt!",
    "fastfood.rules.how.powers.title": "De power-ups",
    "fastfood.rules.how.powers": "Een geserveerd gerecht kan een power-up opleveren: druk op E (of op de kleine knop) om hem te gebruiken. De raket prikt de parachute van de koploper lek.",
    "fastfood.rules.how.goal": "Elk heel geserveerd gerecht is een ster waard. Wie als eerste al zijn sterren heeft, wint; na vijf minuten wint wie de meeste heeft.",
    "fastfood.power.1": "Raket",
    "fastfood.power.2": "Schild",
    "fastfood.power.3": "Grote parachute",
    "fastfood.power.1.text": "Gaat op de koploper af: hij prikt de parachute van zijn gerecht lek, dat in stukken valt, behalve als het al vlak bij de tafel is.",
    "fastfood.power.2.text": "Beschermt je gerecht tegen een raket, tot het geserveerd is.",
    "fastfood.power.3.text": "Je volgende parachute remt tien keer zo hard: open hem op het allerlaatste moment!",
