    "werewolf.rules.tab.game": "Het spel",
    "werewolf.rules.tab.how": "Hoe speel je?",
    "werewolf.rules.tab.roles": "De rollen",
    "werewolf.rules.help_title": "Weerwolf: de regels",
    "werewolf.rules.help": "Spelregels",
    "werewolf.rules.wolves_count": "Weerwolven",
    "werewolf.rules.auto": "Auto (%n%)",
    "werewolf.rules.roles": "Rollen in het dorp",
    "werewolf.rules.classic": "Klassiek",
    "werewolf.rules.all": "Alle",
    "werewolf.rules.none": "Geen",
    "werewolf.rules.draw": "%n% plaatsen voor %count% aangevinkte rollen: de rollen van elk spel worden daaruit geloot. De speciale wolven nemen de plaats in van weerwolven.",
    "werewolf.rules.fill": "De overige plaatsen zijn burgers. De speciale wolven nemen de plaats in van weerwolven.",
    "werewolf.rules.roles_hint": "Klik op een rol om de kaart te zien en alles wat die rol kan.",
    "werewolf.how.goal.title": "Het doel van het spel",
    "werewolf.how.goal.text": "Tussen de burgers verstoppen zich weerwolven. Het dorp moet ze ontmaskeren en wegstemmen; de weerwolven moeten het dorp opeten zonder betrapt te worden. Sommige rollen spelen alleen en winnen op hun eigen manier.",
    "werewolf.how.start.title": "Het begin",
    "werewolf.how.start.text": "Aan het begin van het spel krijgt iedereen in het geheim een rol: je kaart laat hem zien, met zijn kracht. Laat hem nooit zien: lieg als het moet!",
    "werewolf.how.night.title": "De nacht",
    "werewolf.how.night.text": "'s Nachts slaapt het dorp en mag niemand praten, maar de weerwolven fluisteren met elkaar. De rollen worden een voor een wakker: Cupido en de rollen van de eerste nacht, de Beschermer, de Ziener, de Vos, de Raaf, dan kiezen de weerwolven een prooi, daarna de Heks, de Fluitspeler... Ben jij aan de beurt, dan zegt je paneel wat je moet doen: klik op de naam van een speler, boven zijn hoofd, om hem te kiezen.",
    "werewolf.how.day.title": "De dag",
    "werewolf.how.day.text": "Bij dageraad vertelt de verteller wie er die nacht gestorven is, en diens kaart wordt aan iedereen getoond. Daarna overlegt het dorp in de chat: wie liegt er? Wie is te stil? Ben je klaar, klik dan op \"Naar de stemming\".",
    "werewolf.how.vote.title": "De stemming",
    "werewolf.how.vote.text": "Elke speler stemt tegen wie hij verdenkt door op zijn naam te klikken. De speler met de meeste stemmen wordt uitgeschakeld en zijn kaart wordt omgedraaid. Bij een gelijkspel wordt niemand uitgeschakeld (behalve als er een Zondebok is).",
    "werewolf.how.death.title": "De doden",
    "werewolf.how.death.text": "Een dode speler praat niet meer met de levenden: hij kijkt naar het spel en praat met de andere doden. De Jager schiet bij zijn dood nog één laatste keer.",
    "werewolf.how.win.title": "Wie wint?",
    "werewolf.how.win.text": "Het dorp wint als er geen enkele weerwolf meer over is. De weerwolven winnen als er alleen nog weerwolven over zijn. Twee geliefden uit verschillende kampen winnen als zij de laatste twee zijn. De Witte weerwolf, de Fluitspeler en de Engel winnen alleen, elk op hun eigen manier.",
    "werewolf.how.tips.title": "Tips",
    "werewolf.how.tips.text": "Praat, maar niet te veel. Let op de stemmen: weerwolven stemmen vaak samen. Een Ziener die zich te vroeg bekendmaakt, leeft niet lang!",
    "werewolf.error.nothing_to_do": "Er is nu niets te doen.",
    "wobble.lobby.title": "Wobble Squabble",
    "wobble.intro": "Twee spelers, één balk, één zwembad. Houd je evenwicht en stuur je tegenstander kopje-onder!",
    "wobble.no_games": "Nog geen duels: open er een en daag een speler of een robot uit.",
