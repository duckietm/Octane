    "werewolf.role.sister.plural": "Zussen",
    "werewolf.role.wild_child": "Wild kind",
    "werewolf.role.wolf_dog": "Wolfshond",
    "werewolf.role.big_bad_wolf": "Grote boze wolf",
    "werewolf.role.accursed_father": "Besmettelijke oerwolf",
    "werewolf.role.white_wolf": "Witte weerwolf",
    "werewolf.role.piper": "Fluitspeler",
    "werewolf.role.angel": "Engel",
    "werewolf.camp.village": "Het dorp",
    "werewolf.camp.wolves": "De weerwolven",
    "werewolf.camp.alone": "Solo",
    "werewolf.in_pack": "In de roedel",
    "werewolf.charmed": "Betoverd",
    "werewolf.a_werewolf": "Een weerwolf",
    "werewolf.someone": "Iemand",
    "werewolf.power.little_girl": "'s Nachts bespioneer je de weerwolven: je leest hun berichten en ziet hun slachtoffer, zonder te zien wie ze zijn.",
    "werewolf.power.elder": "Je overleeft de eerste aanval van de weerwolven. Als het dorp jou doodt, verliest het zijn krachten.",
    "werewolf.power.idiot": "Als het dorp tegen jou stemt, herkent het je en spaart het je: je blijft, maar je stemt niet meer.",
    "werewolf.power.scapegoat": "Eindigt de stemming in een gelijkspel, dan word jij uitgeschakeld.",
    "werewolf.power.raven": "Wijs elke nacht een speler aan: morgen begint hij de stemming met twee stemmen tegen zich.",
    "werewolf.power.fox": "Snuffel elke nacht aan een speler en zijn twee buren: je weet of er een weerwolf tussen zit. Eén vergissing en je raakt je neus kwijt.",
    "werewolf.power.bear_tamer": "Elke ochtend gromt je beer als er een weerwolf naast je zit.",
    "werewolf.power.knight": "Als de weerwolven jou opeten, doodt je roestige zwaard de volgende nacht de eerste weerwolf links van je.",
    "werewolf.power.sister": "Jij en je zus kennen elkaar: jullie kunnen elkaar vertrouwen.",
    "werewolf.power.wild_child": "Kies in de eerste nacht een voorbeeld. Als je voorbeeld sterft, word je een weerwolf.",
    "werewolf.power.wolf_dog": "Kies in de eerste nacht je kamp: burger blijven of je bij de weerwolven aansluiten.",
    "werewolf.power.big_bad_wolf": "Je jaagt met de roedel en daarna alleen: elke nacht een prooi extra, zolang er geen weerwolf dood is.",
    "werewolf.power.accursed_father": "Eén keer per spel kun je de prooi van de roedel besmetten in plaats van opeten: die wordt dan een weerwolf.",
    "werewolf.power.white_wolf": "Je jaagt met de roedel, maar je speelt voor jezelf: om de andere nacht mag je een weerwolf opeten. Win alleen.",
    "werewolf.power.piper": "Betover elke nacht twee spelers. Je wint alleen als alle andere levende spelers betoverd zijn.",
    "werewolf.power.angel": "Laat je op de eerste dag (of in de eerste nacht) uitschakelen en je wint alleen. Zo niet, dan speel je met het dorp.",
    "werewolf.desc.werewolf": "Elke nacht wordt de roedel wakker, kiest samen een slachtoffer en eet het op. Overdag zitten de weerwolven tussen de burgers en doen ze alsof ze er een van zijn. Ze winnen als er alleen nog weerwolven over zijn.",
    "werewolf.desc.villager": "De Burger heeft geen andere kracht dan zijn stem. Luister, stel vragen, ontmasker de leugens: het dorp wint als alle weerwolven verdwenen zijn.",
    "werewolf.desc.seer": "Elke nacht kijkt de Ziener in de glazen bol en ontdekt de rol van een speler naar keuze. Gebruik wat je weet zonder jezelf te verraden: de weerwolven willen jou maar al te graag opeten.",
    "werewolf.desc.witch": "De Heks wordt na de weerwolven wakker en hoort wie ze hebben aangevallen. Ze heeft een levensdrankje om die speler te redden en een gifdrankje om te doden wie ze wil. Elk drankje werkt maar één keer per spel.",
    "werewolf.desc.hunter": "Als de Jager sterft, hoe dan ook, schiet hij nog één laatste keer: hij kiest een speler die samen met hem sterft. Mik goed!",
    "werewolf.desc.cupid": "In de eerste nacht kiest Cupido twee geliefden (eventueel zichzelf). Zij ontdekken elkaars rol. Als de een sterft, sterft de ander van verdriet. Een verliefde burger en weerwolf winnen samen als zij de laatste twee zijn.",
    "werewolf.desc.guard": "Elke nacht beschermt de Beschermer een speler (eventueel zichzelf) tegen de aanval van de weerwolven. Hij mag niet twee nachten achter elkaar dezelfde speler beschermen. Zijn bescherming houdt het gif van de Heks niet tegen.",
    "werewolf.desc.little_girl": "Terwijl de weerwolven hun slachtoffer kiezen, doet het Klein meisje haar ogen op een kiertje: ze leest wat de roedel zegt en wie ze kiezen, maar ze ziet niet wie er praat.",
    "werewolf.desc.elder": "De Dorpsoudste is taai: de weerwolven moeten hem twee keer aanvallen om hem te doden. Maar als het dorp hem doodt (met de stemming, de Heks of de Jager), verliest het beschaamde dorp zijn speciale krachten.",
    "werewolf.desc.idiot": "Als het dorp tegen de Dorpsgek stemt, ziet iedereen zijn rol en wordt hij gespaard: hij blijft in het dorp, maar hij mag niet meer stemmen.",
    "werewolf.desc.scapegoat": "Eindigt de stemming in een gelijkspel, dan wordt er niemand anders uitgeschakeld: de Zondebok betaalt voor iedereen.",
    "werewolf.desc.raven": "Elke nacht mag de Raaf een speler aanwijzen. De volgende dag begint die speler de stemming met twee stemmen tegen zich, en iedereen weet het.",
    "werewolf.desc.fox": "Elke nacht snuffelt de Vos aan een speler en zijn twee levende buren. Zit er een weerwolf tussen die drie, dan ruikt hij het. Zo niet, dan raakt hij zijn neus en zijn kracht voor de rest van het spel kwijt.",
    "werewolf.desc.bear_tamer": "Elke ochtend gromt de beer van de Berenleider (iedereen hoort het) als minstens een van de twee levende buren van zijn baas een weerwolf is.",
    "werewolf.desc.knight": "Als de weerwolven de Ridder opeten, verwondt zijn roestige zwaard een van hen: de eerste weerwolf links van hem sterft de volgende nacht aan tetanus.",
    "werewolf.desc.sister": "De twee Zussen kennen elkaar vanaf de eerste nacht. Twee spelers die elkaar kunnen vertrouwen: een grote hulp voor het dorp.",
    "werewolf.desc.wild_child": "In de eerste nacht kiest het Wild kind een voorbeeld. Zolang dat voorbeeld leeft, speelt het voor het dorp. Sterft het voorbeeld, dan wordt het een weerwolf en sluit het zich bij de roedel aan.",
    "werewolf.desc.wolf_dog": "In de eerste nacht kiest de Wolfshond: een trouwe burger blijven, of zich bij de weerwolven aansluiten en de rest van het spel met hen jagen.",
    "werewolf.desc.big_bad_wolf": "De Grote boze wolf jaagt met de roedel, wordt daarna alleen wakker en eet een tweede slachtoffer op, zolang er geen lid van de roedel dood is.",
    "werewolf.desc.accursed_father": "Eén keer per spel, als de roedel zijn prooi heeft gekozen, kan de Besmettelijke oerwolf die besmetten in plaats van opeten: de prooi overleeft, maar wordt een weerwolf en houdt zijn kracht.",
    "werewolf.desc.white_wolf": "De Witte weerwolf jaagt met de roedel, maar speelt alleen voor zichzelf: om de andere nacht mag hij een weerwolf opeten. Hij wint als hij als laatste overblijft.",
    "werewolf.desc.piper": "Elke nacht betovert de Fluitspeler twee spelers. De betoverden weten wie er nog meer betoverd is. Hij wint alleen zodra alle andere levende spelers betoverd zijn.",
    "werewolf.desc.angel": "De Engel wil meteen naar de hemel: wordt hij op de eerste dag uitgeschakeld (of in de eerste nacht opgegeten), dan wint hij alleen en stopt het spel. Zo niet, dan wordt hij een gewone burger.",
    "werewolf.step.wolf_dog": "De Wolfshond",
    "werewolf.step.wild_child": "Het Wild kind",
    "werewolf.step.fox": "De Vos",
    "werewolf.step.raven": "De Raaf",
    "werewolf.step.accursed": "De Besmettelijke oerwolf",
    "werewolf.step.big_bad_wolf": "De Grote boze wolf",
    "werewolf.step.white_wolf": "De Witte weerwolf",
    "werewolf.step.piper": "De Fluitspeler",
    "werewolf.log.step.wolf_dog": "De Wolfshond wordt wakker en kiest zijn kamp...",
    "werewolf.log.step.wild_child": "Het Wild kind wordt wakker en kiest zijn voorbeeld...",
    "werewolf.log.step.fox": "De Vos wordt wakker en snuffelt in het dorp...",
    "werewolf.log.step.raven": "De Raaf wordt wakker en zoekt een schouder om op te landen...",
    "werewolf.log.step.accursed": "De Besmettelijke oerwolf vraagt zich af of hij zal bijten...",
    "werewolf.log.step.big_bad_wolf": "De Grote boze wolf wordt wakker, nog steeds uitgehongerd...",
    "werewolf.log.step.white_wolf": "De Witte weerwolf wordt wakker, helemaal alleen...",
    "werewolf.log.step.piper": "De Fluitspeler wordt wakker en speelt zijn melodie...",
    "werewolf.log.sister": "Je zus is %name%. Jullie kunnen elkaar vertrouwen.",
    "werewolf.log.fox_yes": "Je snuit trilt: er zit een weerwolf bij %name% (of %name% is er zelf een).",
    "werewolf.log.fox_no": "Geen weerwolf bij %name%... je bent je neus kwijt.",
    "werewolf.log.raven": "Er is een raaf op de schouder van %name% geland: twee stemmen tegen.",
    "werewolf.log.pack_joins.infected": "De beet heeft gewerkt bij %name%: de roedel heeft er een lid bij!",
    "werewolf.log.pack_joins.wild_child": "%name%, het Wild kind, sluit zich bij de roedel aan!",
    "werewolf.log.pack_joins.wolf_dog": "%name%, de Wolfshond, sluit zich bij de roedel aan!",
    "werewolf.log.infected": "De Besmettelijke oerwolf heeft je gebeten: je hoort nu bij de roedel! Je houdt je kracht, en je jaagt met hen mee.",
    "werewolf.log.wolf_dog_wolf": "Je sluit je aan bij de weerwolven: vanaf vannacht jaag je met de roedel.",
    "werewolf.log.wolf_dog_village": "Je blijft een trouwe burger.",
    "werewolf.log.wild_child_model": "Je voorbeeld is %name%. Als die sterft, word je een weerwolf.",
    "werewolf.log.wild_child_turns": "Je voorbeeld %name% is er niet meer: je wordt een weerwolf!",
    "werewolf.log.elder_survives": "De weerwolven probeerden je op te eten, maar je hebt het volgehouden. De volgende keer heb je dat geluk niet.",
    "werewolf.log.elder_curse": "Het dorp heeft zijn Dorpsoudste, %name%, gedood: uit schaamte verliezen de speciale rollen van het dorp hun krachten.",
    "werewolf.log.idiot_spared": "%name% is de Dorpsgek: het dorp spaart hem of haar, maar die stemt niet meer.",
    "werewolf.log.scapegoat": "Gelijkspel! De Zondebok, %name%, betaalt voor iedereen.",
    "werewolf.log.vote_none": "Niemand heeft gestemd: niemand wordt uitgeschakeld.",
    "werewolf.log.bear_growls": "Grrr! De beer van %name% gromt: er zit een weerwolf naast!",
    "werewolf.log.bear_quiet": "De beer van %name% blijft rustig.",
    "werewolf.log.charmed": "De melodie van de Fluitspeler: de betoverden zijn %names%.",
    "werewolf.log.win.white_wolf": "De Witte weerwolf wint, alleen op de puinhopen van het dorp!",
    "werewolf.log.win.piper": "De Fluitspeler wint: het hele dorp danst op zijn melodie!",
    "werewolf.log.win.angel": "De Engel wint: hij is regelrecht naar de hemel gegaan!",
    "werewolf.cause.white_wolf": "heeft de Witte weerwolf niet overleefd",
    "werewolf.cause.rust": "sterft aan tetanus, door het roestige zwaard van de Ridder",
    "werewolf.cause.scapegoat": "betaalt voor het gelijkspel",
    "werewolf.instruction.wild_child": "Kies je voorbeeld. Als die sterft, word je een weerwolf.",
    "werewolf.button.wild_child": "Kiezen",
    "werewolf.instruction.fox": "Kies een speler om aan te snuffelen: je weet dan of er een weerwolf zit tussen hem en zijn twee buren.",
    "werewolf.button.fox": "Snuffelen",
    "werewolf.instruction.raven": "Kies een speler om aan te wijzen: morgen begint hij de stemming met twee stemmen tegen zich.",
    "werewolf.button.raven": "Aanwijzen",
