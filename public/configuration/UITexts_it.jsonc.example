    "werewolf.wolf_dog.village": "Resta contadino",
    "werewolf.wolf_dog.wolf": "Unisciti ai lupi mannari",
    "werewolf.accursed.what": "Il branco ha scelto %name%. Infettarlo invece di divorarlo (una sola volta per partita)?",
    "werewolf.accursed.infect": "Infetta %name%",
    "werewolf.accursed.devour": "Lascia che venga divorato",
