    "werewolf.rules.open": "Crea il villaggio",
    "werewolf.rules.save": "Salva",
    "werewolf.close_window": "Chiudi",
    "werewolf.role.little_girl": "Bambina",
    "werewolf.role.elder": "Anziano",
    "werewolf.role.idiot": "Scemo del villaggio",
    "werewolf.role.scapegoat": "Capro espiatorio",
    "werewolf.role.raven": "Corvo",
    "werewolf.role.fox": "Volpe",
    "werewolf.role.bear_tamer": "Domatore d'orsi",
    "werewolf.role.knight": "Cavaliere dalla spada arrugginita",
    "werewolf.role.sister": "Sorella",
    "werewolf.role.sister.plural": "Sorelle",
    "werewolf.role.wild_child": "Bambino selvaggio",
    "werewolf.role.wolf_dog": "Cane lupo",
    "werewolf.role.big_bad_wolf": "Grande lupo cattivo",
    "werewolf.role.accursed_father": "Padre dei lupi infetto",
    "werewolf.role.white_wolf": "Lupo bianco",
    "werewolf.role.piper": "Pifferaio",
    "werewolf.role.angel": "Angelo",
    "werewolf.camp.village": "Il villaggio",
    "werewolf.camp.wolves": "I lupi mannari",
    "werewolf.camp.alone": "Solitario",
    "werewolf.in_pack": "Nel branco",
    "werewolf.charmed": "Incantato",
    "werewolf.a_werewolf": "Un lupo mannaro",
    "werewolf.someone": "Qualcuno",
    "werewolf.power.little_girl": "Di notte spii i lupi mannari: leggi i loro messaggi e scopri la loro vittima, senza vedere chi sono.",
    "werewolf.power.elder": "Sopravvivi al primo attacco dei lupi mannari. Se il villaggio ti uccide, perde i suoi poteri.",
    "werewolf.power.idiot": "Se il villaggio vota contro di te, ti riconosce e ti risparmia: resti in gioco, ma non voti più.",
    "werewolf.power.scapegoat": "Se il voto finisce in pareggio, vieni eliminato tu.",
    "werewolf.power.raven": "Ogni notte, indica un giocatore: domani inizierà il voto con due voti contro.",
    "werewolf.power.fox": "Ogni notte, annusa un giocatore e i suoi due vicini: scopri se tra loro c'è un lupo mannaro. Se sbagli, perdi il fiuto.",
    "werewolf.power.bear_tamer": "Ogni mattina il tuo orso ringhia se un lupo mannaro è seduto accanto a te.",
    "werewolf.power.knight": "Se i lupi mannari ti divorano, la tua spada arrugginita uccide il primo lupo mannaro alla tua sinistra la notte successiva.",
    "werewolf.power.sister": "Tu e tua sorella vi conoscete: potete fidarvi l'una dell'altra.",
    "werewolf.power.wild_child": "La prima notte, scegli un modello. Se il tuo modello muore, diventi un lupo mannaro.",
    "werewolf.power.wolf_dog": "La prima notte, scegli la tua squadra: restare contadino o unirti ai lupi mannari.",
    "werewolf.power.big_bad_wolf": "Cacci con il branco, poi da solo: una preda in più ogni notte, finché nessun lupo mannaro è morto.",
    "werewolf.power.accursed_father": "Una volta per partita, invece di divorare la preda del branco, la infetti: diventa un lupo mannaro.",
    "werewolf.power.white_wolf": "Cacci con il branco, ma giochi da solo: una notte su due puoi divorare un lupo mannaro. Vinci da solo.",
    "werewolf.power.piper": "Ogni notte, incanta due giocatori. Vinci da solo quando tutti gli altri vivi sono incantati.",
    "werewolf.power.angel": "Fatti eliminare il primo giorno (o la prima notte) e vinci da solo. Altrimenti giochi con il villaggio.",
    "werewolf.desc.werewolf": "Ogni notte il branco si sveglia, sceglie insieme una vittima e la divora. Di giorno i lupi mannari si siedono tra gli abitanti e fingono di essere come loro. Vincono quando restano solo lupi mannari.",
    "werewolf.desc.villager": "Il contadino non ha altro potere che il suo voto. Ascolta, fai domande, scova le bugie: il villaggio vince quando tutti i lupi mannari sono spariti.",
    "werewolf.desc.seer": "Ogni notte la Veggente consulta la sua sfera di cristallo e scopre il ruolo di un giocatore a sua scelta. Usa quello che sai senza svelarti: i lupi mannari sognano di divorarti.",
    "werewolf.desc.witch": "La Strega si sveglia dopo i lupi mannari e scopre chi hanno attaccato. Ha una pozione di vita, per salvare quel giocatore, e una pozione di morte, per uccidere chi vuole. Ogni pozione si usa una sola volta per partita.",
    "werewolf.desc.hunter": "Quando il Cacciatore muore, per qualunque motivo, spara un ultimo colpo di fucile: sceglie un giocatore che muore con lui. Mira bene!",
    "werewolf.desc.cupid": "La prima notte, Cupido sceglie due innamorati (anche se stesso, se vuole). Scoprono l'uno il ruolo dell'altro. Se uno muore, l'altro muore di dolore. Un contadino e un lupo mannaro innamorati vincono insieme se sono gli ultimi due.",
    "werewolf.desc.guard": "Ogni notte la Guardia protegge un giocatore (anche se stessa) dall'attacco dei lupi mannari. Non può proteggere lo stesso giocatore per due notti di fila. La sua protezione non ferma il veleno della Strega.",
    "werewolf.desc.little_girl": "Mentre i lupi mannari scelgono la loro vittima, la Bambina socchiude gli occhi: legge cosa dice il branco e chi sceglie, ma non vede chi parla.",
    "werewolf.desc.elder": "L'Anziano è robusto: i lupi mannari devono attaccarlo due volte per ucciderlo. Ma se è il villaggio a ucciderlo (con il voto, la Strega o il Cacciatore), il villaggio, pieno di vergogna, perde i suoi poteri speciali.",
    "werewolf.desc.idiot": "Quando il villaggio vota contro lo Scemo del villaggio, tutti scoprono il suo ruolo e lo risparmiano: resta nel villaggio, ma non può più votare.",
    "werewolf.desc.scapegoat": "Quando il voto finisce in pareggio, nessun altro viene eliminato: è il Capro espiatorio a pagare per tutti.",
    "werewolf.desc.raven": "Ogni notte il Corvo può indicare un giocatore. Il giorno dopo, quel giocatore inizia il voto con due voti contro, e tutti lo sanno.",
    "werewolf.desc.fox": "Ogni notte la Volpe annusa un giocatore e i suoi due vicini vivi. Se tra i tre c'è un lupo mannaro, lo sente. Altrimenti perde il fiuto e il suo potere per il resto della partita.",
    "werewolf.desc.bear_tamer": "Ogni mattina l'orso del Domatore ringhia (tutti lo sentono) se almeno uno dei due vicini vivi del suo padrone è un lupo mannaro.",
    "werewolf.desc.knight": "Se i lupi mannari divorano il Cavaliere, la sua spada arrugginita ferisce uno di loro: il primo lupo mannaro alla sua sinistra muore di tetano la notte successiva.",
    "werewolf.desc.sister": "Le due Sorelle si conoscono fin dalla prima notte. Due giocatori che possono fidarsi l'uno dell'altro: un aiuto prezioso per il villaggio.",
    "werewolf.desc.wild_child": "La prima notte, il Bambino selvaggio sceglie un modello. Finché il suo modello è vivo, gioca per il villaggio. Se il suo modello muore, diventa un lupo mannaro e si unisce al branco.",
    "werewolf.desc.wolf_dog": "La prima notte, il Cane lupo sceglie: restare un contadino fedele, o unirsi ai lupi mannari e cacciare con loro per il resto della partita.",
    "werewolf.desc.big_bad_wolf": "Il Grande lupo cattivo caccia con il branco, poi si sveglia da solo e divora una seconda vittima, finché nessun membro del branco è morto.",
    "werewolf.desc.accursed_father": "Una volta per partita, quando il branco ha scelto la sua preda, il Padre dei lupi infetto può infettarla invece di divorarla: la preda sopravvive, ma diventa un lupo mannaro e conserva il suo potere.",
    "werewolf.desc.white_wolf": "Il Lupo bianco caccia con il branco, ma gioca solo per se stesso: una notte su due può divorare un lupo mannaro. Vince se è l'ultimo rimasto in vita.",
    "werewolf.desc.piper": "Ogni notte il Pifferaio incanta due giocatori. Gli incantati scoprono chi altro lo è. Vince da solo appena tutti gli altri giocatori vivi sono incantati.",
    "werewolf.desc.angel": "L'Angelo vuole salire subito in cielo: se viene eliminato il primo giorno (o divorato la prima notte), vince da solo e la partita finisce. Altrimenti diventa un semplice contadino.",
    "werewolf.step.wolf_dog": "Il Cane lupo",
    "werewolf.step.wild_child": "Il Bambino selvaggio",
    "werewolf.step.fox": "La Volpe",
    "werewolf.step.raven": "Il Corvo",
    "werewolf.step.accursed": "Il Padre dei lupi infetto",
    "werewolf.step.big_bad_wolf": "Il Grande lupo cattivo",
    "werewolf.step.white_wolf": "Il Lupo bianco",
    "werewolf.step.piper": "Il Pifferaio",
    "werewolf.log.step.wolf_dog": "Il Cane lupo si sveglia e sceglie la sua squadra...",
    "werewolf.log.step.wild_child": "Il Bambino selvaggio si sveglia e sceglie il suo modello...",
    "werewolf.log.step.fox": "La Volpe si sveglia e annusa il villaggio...",
    "werewolf.log.step.raven": "Il Corvo si sveglia e cerca una spalla su cui posarsi...",
    "werewolf.log.step.accursed": "Il Padre dei lupi infetto si chiede se mordere...",
    "werewolf.log.step.big_bad_wolf": "Il Grande lupo cattivo si sveglia, ancora affamato...",
    "werewolf.log.step.white_wolf": "Il Lupo bianco si sveglia, da solo...",
    "werewolf.log.step.piper": "Il Pifferaio si sveglia e suona la sua melodia...",
    "werewolf.log.sister": "Tua sorella è %name%. Potete fidarvi l'una dell'altra.",
    "werewolf.log.fox_yes": "Il tuo naso freme: c'è un lupo mannaro vicino a %name% (oppure è %name%).",
    "werewolf.log.fox_no": "Nessun lupo mannaro vicino a %name%... hai perso il fiuto.",
    "werewolf.log.raven": "Un corvo si è posato sulla spalla di %name%: due voti contro.",
    "werewolf.log.pack_joins.infected": "Il morso ha fatto effetto su %name%: il branco ha un membro in più!",
    "werewolf.log.pack_joins.wild_child": "%name%, il Bambino selvaggio, si unisce al branco!",
    "werewolf.log.pack_joins.wolf_dog": "%name%, il Cane lupo, si unisce al branco!",
    "werewolf.log.infected": "Il Padre dei lupi infetto ti ha affondato le zanne addosso: ora fai parte del branco! Conservi il tuo potere, e cacci con loro.",
    "werewolf.log.wolf_dog_wolf": "Ti unisci ai lupi mannari: cacci con il branco da stanotte.",
    "werewolf.log.wolf_dog_village": "Resti un contadino fedele.",
    "werewolf.log.wild_child_model": "Il tuo modello è %name%. Se muore, diventi un lupo mannaro.",
    "werewolf.log.wild_child_turns": "Il tuo modello %name% non c'è più: diventi un lupo mannaro!",
    "werewolf.log.elder_survives": "I lupi mannari hanno provato a divorarti, ma hai resistito. La prossima volta non avrai questa fortuna.",
    "werewolf.log.elder_curse": "Il villaggio ha ucciso il suo Anziano, %name%: per la vergogna, i ruoli speciali del villaggio perdono i loro poteri.",
    "werewolf.log.idiot_spared": "%name% è lo Scemo del villaggio: il villaggio lo risparmia, ma non voterà più.",
    "werewolf.log.scapegoat": "Pareggio! Il Capro espiatorio, %name%, paga per tutti.",
    "werewolf.log.vote_none": "Nessuno ha votato: nessuno viene eliminato.",
    "werewolf.log.bear_growls": "Grrr! L'orso di %name% ringhia: un lupo mannaro è seduto lì accanto!",
    "werewolf.log.bear_quiet": "L'orso di %name% resta tranquillo.",
    "werewolf.log.charmed": "La melodia del Pifferaio: gli incantati sono %names%.",
    "werewolf.log.win.white_wolf": "Vince il Lupo bianco, da solo sulle rovine del villaggio!",
    "werewolf.log.win.piper": "Vince il Pifferaio: tutto il villaggio balla al ritmo della sua melodia!",
    "werewolf.log.win.angel": "Vince l'Angelo: è salito dritto in cielo!",
    "werewolf.cause.white_wolf": "non è sopravvissuto al Lupo bianco",
    "werewolf.cause.rust": "muore di tetano, per colpa della spada arrugginita del Cavaliere",
    "werewolf.cause.scapegoat": "paga per il pareggio",
    "werewolf.instruction.wild_child": "Scegli il tuo modello. Se muore, diventi un lupo mannaro.",
    "werewolf.button.wild_child": "Scegli",
    "werewolf.instruction.fox": "Scegli un giocatore da annusare: saprai se c'è un lupo mannaro tra lui e i suoi due vicini.",
    "werewolf.button.fox": "Annusa",
    "werewolf.instruction.raven": "Scegli un giocatore da indicare: domani inizierà il voto con due voti contro.",
    "werewolf.button.raven": "Indica",
    "werewolf.pass.raven": "Nessuno",
    "werewolf.instruction.big_bad_wolf": "Ora sei da solo: scegli una seconda preda da divorare.",
    "werewolf.button.big_bad_wolf": "Divora",
    "werewolf.instruction.white_wolf": "Stanotte puoi divorare un lupo mannaro del branco, oppure risparmiarlo.",
    "werewolf.button.white_wolf": "Divora",
    "werewolf.pass.white_wolf": "Risparmia il branco",
    "werewolf.instruction.piper": "Scegli due giocatori da incantare.",
